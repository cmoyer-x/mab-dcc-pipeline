# ============================================================
# M. abscessus DCC Assignment Pipeline
# Snakemake workflow
#
# Usage:
#   snakemake --cores 16 --use-conda
#   snakemake --cores 16 --use-conda --dry-run
#
# References:
#   Ruis et al. 2021 (Nature Microbiology) PMC8478660
#   Bronson et al. 2021 PMC8390669
#   Dedrick et al. PMC10583746
# ============================================================

configfile: "config.yaml"

import os
import sys
import glob
import datetime

def get_samples():
    fastas = (glob.glob(os.path.join(config["input_dir"], "*.fasta")) +
              glob.glob(os.path.join(config["input_dir"], "*.fna")))
    return [os.path.splitext(os.path.basename(f))[0] for f in fastas]

def get_species_refs():
    return (glob.glob(os.path.join(config["species_refs_dir"], "*.fna")) +
            glob.glob(os.path.join(config["species_refs_dir"], "*.fasta")))

SAMPLES = get_samples()
OUT = config["output_dir"]

# ── Config validation ─────────────────────────────────────────
def validate_config():
    """Validate config.yaml settings before pipeline starts."""
    errors = []

    # Check input directory exists
    if not os.path.isdir(config["input_dir"]):
        errors.append(
            f"input_dir '{config['input_dir']}' does not exist. "
            "Create it and place your FASTA files inside."
        )

    # Check species refs directory exists
    if not os.path.isdir(config["species_refs_dir"]):
        errors.append(
            f"species_refs_dir '{config['species_refs_dir']}' does not exist. "
            "Run: ls references/species/ to check reference files."
        )

    # Check SNP thresholds make sense
    t1 = config.get("transmission", {}).get("threshold_strict", 10)
    t2 = config.get("transmission", {}).get("threshold_broad", 20)
    if t1 >= t2:
        errors.append(
            f"transmission.threshold_strict ({t1}) must be less than "
            f"transmission.threshold_broad ({t2})."
        )
    if t1 < 1 or t2 < 1:
        errors.append("Transmission thresholds must be >= 1 SNP.")

    dcc_thresh = config.get("transmission", {}).get("dcc_threshold", 500)
    if dcc_thresh < t2:
        errors.append(
            f"transmission.dcc_threshold ({dcc_thresh}) should be greater than "
            f"threshold_broad ({t2})."
        )

    # Check resources
    cores = config.get("resources", {}).get("default_cores", 4)
    if cores < 1:
        errors.append("resources.default_cores must be >= 1.")

    if errors:
        print("\n[mab-dcc-pipeline] CONFIG ERRORS:")
        for e in errors:
            print(f"  ERROR: {e}")
        raise ValueError(f"Config validation failed with {len(errors)} error(s). See above.")

    print("[mab-dcc-pipeline] Config validation passed")

validate_config()

# ── Progress logger ───────────────────────────────────────────
def log_progress(message):
    """Write timestamped progress message to log file."""
    os.makedirs(OUT, exist_ok=True)
    log_path = os.path.join(OUT, "pipeline_progress.log")
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(log_path, "a") as f:
        f.write(f"[{timestamp}] {message}\n")
    print(f"[mab-dcc-pipeline] {message}")

# ── Dry-run summary ───────────────────────────────────────────
def print_pipeline_summary():
    """Print a friendly summary of what the pipeline will do."""
    n = len(SAMPLES)
    fastas = (glob.glob(os.path.join(config["input_dir"], "*.fasta")) +
              glob.glob(os.path.join(config["input_dir"], "*.fna")))
    total_size = sum(os.path.getsize(f) for f in fastas) / 1e9

    # Check what needs downloading
    abs_ref = config["subspecies_refs"]["abscessus"]["path"]
    need_subsp = not os.path.exists(abs_ref)
    need_dcc   = not os.path.exists(os.path.join(OUT, "references", ".dcc_refs_done"))

    # Runtime estimate (rough, based on experience)
    snippy_hrs  = round(n * 0.05, 1)
    gubbins_hrs = round(n * 0.08, 1)
    total_hrs   = snippy_hrs + gubbins_hrs + 2

    print("\n" + "="*60)
    print("  M. abscessus DCC Assignment Pipeline")
    print("="*60)
    print(f"  Isolates found:     {n}")
    print(f"  Total input size:   {total_size:.2f} GB")
    print(f"  Output directory:   {OUT}/")

    print(f"  Locations file:     {'YES' if config.get('locations_file') else 'NO (map disabled)'}")
    print("")
    if need_subsp:
        print("  [DOWNLOAD] Subspecies references (~150MB) — first run only")
    if need_dcc:
        print("  [DOWNLOAD] DCC anchor sequences (~3GB) — first run only")
    print("")
    print("  Estimated runtimes (approximate):")
    print(f"    Snippy SNP calling:    ~{snippy_hrs} hours")
    print(f"    Gubbins recombination: ~{gubbins_hrs} hours")
    print(f"    Total estimated:       ~{total_hrs:.0f} hours on {config['resources']['default_cores']} cores")
    print(f"  Note: RAxML tree building is not included in this pipeline.")
    print(f"        See README for tree building instructions.")
    print("="*60 + "\n")

print_pipeline_summary()

# ── Checkpoint helper functions ───────────────────────────────
def get_clusters(wildcards):
    """Get list of cluster FASTA files after FastBAPS runs."""
    import glob
    checkpoint_output = checkpoints.split_clusters.get(**wildcards).output.done
    outdir = os.path.dirname(checkpoint_output)
    fastas = glob.glob(os.path.join(outdir, "cluster_*.fasta"))
    return fastas

def get_cluster_ids(wildcards):
    """Get list of cluster IDs after FastBAPS runs."""
    import glob, re
    checkpoint_output = checkpoints.split_clusters.get(**wildcards).output.done
    outdir = os.path.dirname(checkpoint_output)
    fastas = glob.glob(os.path.join(outdir, "cluster_*.fasta"))
    ids = [re.search(r"cluster_(.+)\.fasta", f).group(1) for f in fastas]
    return ids

def get_gubbins_alns(wildcards):
    """Get all Gubbins filtered alignments for snp-dists."""
    import glob, re
    checkpoint_output = checkpoints.split_clusters.get(
        out=wildcards.out, subsp=wildcards.subsp).output.done
    outdir = os.path.dirname(checkpoint_output)
    fastas = glob.glob(os.path.join(outdir, "cluster_*.fasta"))
    # Only match simple numeric cluster IDs e.g. cluster_1.fasta not cluster_1.filtered...fasta
    ids = []
    for f in fastas:
        m = re.search(r"cluster_(\d+)\.fasta$", f)
        if m:
            ids.append(m.group(1))
    return expand("{out}/gubbins_clean/{subsp}/cluster_{cluster}.gubbins_filtered.fasta",
                  out=wildcards.out, subsp=wildcards.subsp, cluster=ids)



# ============================================================
# PHASE 0a — INPUT VALIDATION
# ============================================================

def validate_inputs():
    """Validate input FASTAs before pipeline starts."""
    import os
    import glob

    fastas = (glob.glob(os.path.join(config["input_dir"], "*.fasta")) +
              glob.glob(os.path.join(config["input_dir"], "*.fna")))

    if not fastas:
        raise ValueError(
            f"No FASTA files found in {config['input_dir']}\n"
            "Please place your assemblies in the input/assemblies/ directory."
        )

    n = len(fastas)
    warnings = []
    errors = []

    # Minimum isolate warning
    if n < 5:
        errors.append(
            f"Only {n} isolate(s) found. Minimum 5 required to run the pipeline."
        )
    if n < 20:
        warnings.append(
            f"WARNING: Only {n} isolates found. "
            "FastBAPS clustering and RAxML trees require at least 20-50 isolates "
            "for meaningful results. DCCs may not be detected in small datasets."
        )
    if n < 50:
        warnings.append(
            f"NOTE: {n} isolates is below the recommended minimum of 50 for "
            "reliable DCC assignment. Consider adding more isolates or supplementing "
            "with public genomes from Ruis et al. 2021 (see README)."
        )

    # Validate each FASTA file
    for fasta in fastas:
        size = os.path.getsize(fasta)
        name = os.path.basename(fasta)

        # Check file is not empty
        if size == 0:
            errors.append(f"Empty file: {name}")
            continue

        # Check minimum size (500KB — typical assembly is 5MB)
        if size < 500000:
            warnings.append(
                f"Small file: {name} ({size/1000:.0f}KB) — "
                "expected ~5MB for M. abscessus assembly. May be incomplete."
            )

        # Check valid FASTA format
        try:
            with open(fasta) as f:
                first_line = f.readline().strip()
                if not first_line.startswith(">"):
                    errors.append(f"Invalid FASTA format: {name} — does not start with '>'")
                second_line = f.readline().strip()
                if not second_line:
                    errors.append(f"Empty sequence: {name}")
        except Exception as e:
            errors.append(f"Could not read {name}: {e}")

    # Print warnings
    for w in warnings:
        print(f"[mab-dcc-pipeline] {w}")

    # Raise errors
    if errors:
        raise ValueError(
            "Input validation failed:\n" +
            "\n".join(f"  - {e}" for e in errors)
        )

    print(f"[mab-dcc-pipeline] Input validation passed: {n} isolates found")
    return fastas

# Run validation when pipeline starts
validate_inputs()



# ── Target rule ───────────────────────────────────────────────
def get_final_outputs():
    """Return list of final outputs."""
    outputs = [
        expand("{out}/final/DCC_assignments_FINAL.xlsx", out=OUT),
        expand("{out}/final/transmission_pairs_FINAL.xlsx", out=OUT),
        expand("{out}/final/pipeline_summary.html", out=OUT),
    ]
    # HTML map only if locations file provided
    if config.get("locations_file"):
        outputs.append(
            expand("{out}/final/DCC_transmission_map.html", out=OUT)
        )
    return outputs

rule all:
    input:
        get_final_outputs()



