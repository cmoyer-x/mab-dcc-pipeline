        # expand("{out}/trees/{subsp}/RAxML_bipartitions.{subsp}_final",
        #        out=OUT, subsp=["abscessus", "massiliense"]),


# ============================================================
# PHASE 0 — DOWNLOAD DCC REFERENCE SEQUENCES
# ============================================================

rule download_dcc_references:
    """Download DCC anchor sequences from SRA and NCBI."""
    output:
        done = "{out}/references/.dcc_refs_done"
    params:
        abs_refs = "{out}/dcc_refs/abscessus",
        mas_refs = "{out}/dcc_refs/massiliense"
    conda: "envs/snippy.yaml"
    shell:
        """
        mkdir -p {params.abs_refs} {params.mas_refs}

        # Download abscessus DCC reads via ENA HTTP
        for acc in SRR36966619 ERR363247 ERR1081288 ERR494841 ERR363431 ERR484982; do
            if [ ! -f {params.abs_refs}/${{acc}}_1.fastq.gz ]; then
                echo "Downloading $acc..."
                prefix=$(echo $acc | cut -c1-6)
                suffix=$(echo $acc | cut -c1-9)
                wget -q "http://ftp.sra.ebi.ac.uk/vol1/fastq/${{prefix}}/${{suffix}}/${{acc}}_1.fastq.gz" \
                    -O {params.abs_refs}/${{acc}}_1.fastq.gz || true
                wget -q "http://ftp.sra.ebi.ac.uk/vol1/fastq/${{prefix}}/${{suffix}}/${{acc}}_2.fastq.gz" \
                    -O {params.abs_refs}/${{acc}}_2.fastq.gz || true
            fi
        done

        # Download massiliense DCC reads
        for acc in ERR1045629 ERR2524314 ERR363320; do
            if [ ! -f {params.mas_refs}/${{acc}}_1.fastq.gz ]; then
                echo "Downloading $acc..."
                prefix=$(echo $acc | cut -c1-6)
                suffix=$(echo $acc | cut -c1-9)
                wget -q "http://ftp.sra.ebi.ac.uk/vol1/fastq/${{prefix}}/${{suffix}}/${{acc}}_1.fastq.gz" \
                    -O {params.mas_refs}/${{acc}}_1.fastq.gz || true
                wget -q "http://ftp.sra.ebi.ac.uk/vol1/fastq/${{prefix}}/${{suffix}}/${{acc}}_2.fastq.gz" \
                    -O {params.mas_refs}/${{acc}}_2.fastq.gz || true
            fi
        done

        # Download massiliense assemblies (A47, FLAC047)
        wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/002/799/795/GCF_002799795.1_ASM279979v1/GCF_002799795.1_ASM279979v1_genomic.fna.gz" \
            -O {params.mas_refs}/A47.fna.gz && gunzip -f {params.mas_refs}/A47.fna.gz || true
        wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/002/140/035/GCF_002140035.1_ASM214003v1/GCF_002140035.1_ASM214003v1_genomic.fna.gz" \
            -O {params.mas_refs}/FLAC047.fna.gz && gunzip -f {params.mas_refs}/FLAC047.fna.gz || true

        touch {output.done}
        echo "DCC reference download complete"
        """


rule download_subspecies_refs:
    """Download subspecies reference genomes from NCBI if not present."""
    output:
        abs_ref = config["subspecies_refs"]["abscessus"]["path"],
        mas_ref = config["subspecies_refs"]["massiliense"]["path"],
        bol_ref = config["subspecies_refs"]["bolletii"]["path"]
    shell:
        """
        mkdir -p references/subspecies

        # ATCC19977 — M. a. abscessus reference
        if [ ! -f {output.abs_ref} ]; then
            echo "Downloading ATCC19977 (M. a. abscessus reference)..."
            wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/069/185/GCF_000069185.1_ASM6918v1/GCF_000069185.1_ASM6918v1_genomic.fna.gz" \
                -O {output.abs_ref}.gz
            gunzip {output.abs_ref}.gz
        fi

        # CIP_108297 — M. a. massiliense reference
        if [ ! -f {output.mas_ref} ]; then
            echo "Downloading CIP_108297 (M. a. massiliense reference)..."
            wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/001/792/625/GCF_001792625.1_ASM179262v1/GCF_001792625.1_ASM179262v1_genomic.fna.gz" \
                -O {output.mas_ref}.gz
            gunzip {output.mas_ref}.gz
        fi

        # CCUG_50184 — M. a. bolletii reference
        if [ ! -f {output.bol_ref} ]; then
            echo "Downloading CCUG_50184 (M. a. bolletii reference)..."
            wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/701/545/GCF_000701545.1_ASM70154v1/GCF_000701545.1_ASM70154v1_genomic.fna.gz" \
                -O {output.bol_ref}.gz
            gunzip {output.bol_ref}.gz
        fi

        echo "Subspecies references ready"
        """

