    input:
        aln = "{out}/core/massiliense/core.aln"
    output:
        clusters = "{out}/fastbaps/massiliense/clusters.csv"
    conda: "envs/fastbaps.yaml"
    threads: config["fastbaps"]["threads"]
    shell:
        """
        if [ -s {input.aln} ]; then
            run_fastbaps \
                -i {input.aln} \
                -o {output.clusters} \
                -p {config[fastbaps][prior]} \
                -l {config[fastbaps][levels]} \
                -t {threads}
        else
            echo "No massiliense sequences — skipping FastBAPS"
            touch {output.clusters}
        fi
        """

# ============================================================
# PHASE 4 — RECOMBINATION REMOVAL (GUBBINS)
# ============================================================

checkpoint split_clusters:
    input:
        aln      = "{out}/core/{subsp}/core.aln",
        clusters = "{out}/fastbaps/{subsp}/clusters.csv"
    output:
        done = "{out}/gubbins/{subsp}/.split_done"
    params:
        outdir   = "{out}/gubbins/{subsp}",
        min_seqs = config["gubbins"]["min_taxa"]
    script:
        "scripts/split_by_cluster.py"




# ============================================================
# PHASE 4 — RECOMBINATION REMOVAL (GUBBINS)
# ============================================================

rule gubbins:
    """Run Gubbins recombination removal on each FastBAPS cluster."""
    input:
        fasta = "{out}/gubbins/{subsp}/cluster_{cluster}.fasta"
    output:
        filtered = "{out}/gubbins/{subsp}/cluster_{cluster}.filtered_polymorphic_sites.fasta",
        tree     = "{out}/gubbins/{subsp}/cluster_{cluster}.final_tree.tre"
    params:
        prefix             = "{out}/gubbins/{subsp}/cluster_{cluster}",
        tree_builder       = config["gubbins"]["tree_builder"],
        first_tree_builder = config["gubbins"]["first_tree_builder"]
    threads: config["gubbins"]["threads"]
    conda: "envs/gubbins.yaml"
    shell:
        """
        n_seqs=$(grep -c "^>" {input.fasta} || echo 0)
        if [ "$n_seqs" -lt 4 ]; then
            echo "Cluster {wildcards.cluster}: $n_seqs seqs — too few for Gubbins, copying as-is"
            cp {input.fasta} {output.filtered}
            touch {output.tree}
        else
            cd $(dirname {params.prefix})
            run_gubbins.py \
                --prefix cluster_{wildcards.cluster} \
                --threads {threads} \
                --tree-builder {params.tree_builder} \
                --first-tree-builder {params.first_tree_builder} \
                cluster_{wildcards.cluster}.fasta \
            || run_gubbins.py \
                --prefix cluster_{wildcards.cluster} \
                --threads {threads} \
                --tree-builder fasttree \
                --first-tree-builder fasttree \
                cluster_{wildcards.cluster}.fasta
        fi
        """

rule snp_dists_cluster:
    """Calculate pairwise SNP distances from Gubbins-filtered cluster alignments."""
    input:
        fasta = "{out}/gubbins/{subsp}/cluster_{cluster}.filtered_polymorphic_sites.fasta"
    output:
        tsv = "{out}/snp_distances/{subsp}/cluster_{cluster}.tsv"
    conda: "envs/snippy.yaml"
    shell:
        """
        if [ -s {input.fasta} ]; then
            snp-dists {input.fasta} > {output.tsv}
        else
            touch {output.tsv}
        fi
        """

rule merge_cluster_distances:
    """Merge all per-cluster SNP distance files for transmission pair analysis."""
    input:
        get_gubbins_alns
    output:
        done = "{out}/snp_distances/{subsp}/.merge_done"
    shell:
        "touch {output.done}"

