# ============================================================
# PHASE 0 — DOWNLOAD DCC REFERENCE SEQUENCES
# ============================================================

rule download_dcc_references:
    """Download DCC anchor sequences from SRA and NCBI."""
    output:
        done = "{out}/references/.dcc_refs_done"
    params:
        abs_refs = "{out}/dcc_refs/abscessus",
        mas_refs = "{out}/dcc_refs/massiliense"
    conda: "envs/snippy.yaml"
    shell:
        """
        mkdir -p {params.abs_refs} {params.mas_refs}

        # Download abscessus DCC reads via ENA HTTP
        for acc in SRR36966619 ERR363247 ERR1081288 ERR494841 ERR363431 ERR484982; do
            if [ ! -f {params.abs_refs}/${{acc}}_1.fastq.gz ]; then
                echo "Downloading $acc..."
                prefix=$(echo $acc | cut -c1-6)
                suffix=$(echo $acc | cut -c1-9)
                wget -q "http://ftp.sra.ebi.ac.uk/vol1/fastq/${{prefix}}/${{suffix}}/${{acc}}_1.fastq.gz" \
                    -O {params.abs_refs}/${{acc}}_1.fastq.gz || true
                wget -q "http://ftp.sra.ebi.ac.uk/vol1/fastq/${{prefix}}/${{suffix}}/${{acc}}_2.fastq.gz" \
                    -O {params.abs_refs}/${{acc}}_2.fastq.gz || true
            fi
        done

        # Download massiliense DCC reads
        for acc in ERR1045629 ERR2524314 ERR363320; do
            if [ ! -f {params.mas_refs}/${{acc}}_1.fastq.gz ]; then
                echo "Downloading $acc..."
                prefix=$(echo $acc | cut -c1-6)
                suffix=$(echo $acc | cut -c1-9)
                wget -q "http://ftp.sra.ebi.ac.uk/vol1/fastq/${{prefix}}/${{suffix}}/${{acc}}_1.fastq.gz" \
                    -O {params.mas_refs}/${{acc}}_1.fastq.gz || true
                wget -q "http://ftp.sra.ebi.ac.uk/vol1/fastq/${{prefix}}/${{suffix}}/${{acc}}_2.fastq.gz" \
                    -O {params.mas_refs}/${{acc}}_2.fastq.gz || true
            fi
        done

        # Download massiliense assemblies (A47, FLAC047)
        wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/002/799/795/GCF_002799795.1_ASM279979v1/GCF_002799795.1_ASM279979v1_genomic.fna.gz" \
            -O {params.mas_refs}/A47.fna.gz && gunzip -f {params.mas_refs}/A47.fna.gz || true
        wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/002/140/035/GCF_002140035.1_ASM214003v1/GCF_002140035.1_ASM214003v1_genomic.fna.gz" \
            -O {params.mas_refs}/FLAC047.fna.gz && gunzip -f {params.mas_refs}/FLAC047.fna.gz || true

        touch {output.done}
        echo "DCC reference download complete"
        """


rule download_subspecies_refs:
    """Download subspecies reference genomes from NCBI if not present."""
    output:
        abs_ref = config["subspecies_refs"]["abscessus"]["path"],
        mas_ref = config["subspecies_refs"]["massiliense"]["path"],
        bol_ref = config["subspecies_refs"]["bolletii"]["path"]
    shell:
        """
        mkdir -p references/subspecies

        # ATCC19977 — M. a. abscessus reference
        if [ ! -f {output.abs_ref} ]; then
            echo "Downloading ATCC19977 (M. a. abscessus reference)..."
            wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/069/185/GCF_000069185.1_ASM6918v1/GCF_000069185.1_ASM6918v1_genomic.fna.gz" \
                -O {output.abs_ref}.gz
            gunzip {output.abs_ref}.gz
        fi

        # CIP_108297 — M. a. massiliense reference
        if [ ! -f {output.mas_ref} ]; then
            echo "Downloading CIP_108297 (M. a. massiliense reference)..."
            wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/001/792/625/GCF_001792625.1_ASM179262v1/GCF_001792625.1_ASM179262v1_genomic.fna.gz" \
                -O {output.mas_ref}.gz
            gunzip {output.mas_ref}.gz
        fi

        # CCUG_50184 — M. a. bolletii reference
        if [ ! -f {output.bol_ref} ]; then
            echo "Downloading CCUG_50184 (M. a. bolletii reference)..."
            wget -q "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/701/545/GCF_000701545.1_ASM70154v1/GCF_000701545.1_ASM70154v1_genomic.fna.gz" \
                -O {output.bol_ref}.gz
            gunzip {output.bol_ref}.gz
        fi

        echo "Subspecies references ready"
        """

# ============================================================
# PHASE 1 — SPECIES IDENTIFICATION (MASH)
# ============================================================

rule mash_sketch_references:
    input:
        refs = get_species_refs()
    output:
        sketch = "{out}/mash/species_refs.msh"
    conda: "envs/mash.yaml"
    threads: config["resources"]["default_cores"]
    shell:
        """
        mash sketch -o {wildcards.out}/mash/species_refs \
            -s {config[mash][sketch_size]} \
            -k {config[mash][kmer_size]} \
            {input.refs}
        """

rule mash_species_distance:
    input:
        query  = config["input_dir"] + "/{sample}.fasta",
        sketch = "{out}/mash/species_refs.msh"
    output:
        dist = "{out}/mash/distances/{sample}.tsv"
    conda: "envs/mash.yaml"
    shell:
        "mash dist {input.sketch} {input.query} > {output.dist}"

rule assign_species:
    input:
        distances = expand("{out}/mash/distances/{sample}.tsv",
                          out=OUT, sample=SAMPLES)
    output:
        assignments       = "{out}/mash/species_assignments.tsv",
        abscessus_list    = "{out}/mash/abscessus_samples.txt",
        non_abscessus_list= "{out}/mash/non_abscessus_samples.txt",
        report            = "{out}/mash/species_report.txt"
    params:
        threshold = config["mash"]["species_threshold"]
    script:
        "scripts/assign_species.py"

rule mash_sketch_subspecies_refs:
    """Sketch all three subspecies references into a single database."""
    input:
        abs_ref = config["subspecies_refs"]["abscessus"]["path"],
        mas_ref = config["subspecies_refs"]["massiliense"]["path"],
        bol_ref = config["subspecies_refs"]["bolletii"]["path"]
    output:
        sketch = "{out}/mash/subspecies_refs.msh"
    conda: "envs/mash.yaml"
    shell:
        """
        mash sketch -o {wildcards.out}/mash/subspecies_refs \
            {input.abs_ref} {input.mas_ref} {input.bol_ref}
        """

rule mash_subspecies_distance:
    input:
        query          = config["input_dir"] + "/{sample}.fasta",
        abscessus_list = "{out}/mash/abscessus_samples.txt",
        sketch         = "{out}/mash/subspecies_refs.msh"
    output:
        dist = "{out}/mash/subspecies/{sample}.tsv"
    conda: "envs/mash.yaml"
    shell:
        """
        if grep -q {wildcards.sample} {input.abscessus_list}; then
            mash dist {input.sketch} {input.query} > {output.dist}
        else
            touch {output.dist}
        fi
        """

rule assign_subspecies:
    input:
        distances      = expand("{out}/mash/subspecies/{sample}.tsv",
                               out=OUT, sample=SAMPLES),
        abscessus_list = "{out}/mash/abscessus_samples.txt"
    output:
        assignments = "{out}/mash/subspecies_assignments.tsv",
        abs_list    = "{out}/mash/subspecies/abscessus_samples.txt",
        mas_list    = "{out}/mash/subspecies/massiliense_samples.txt",
        bol_list    = "{out}/mash/subspecies/bolletii_samples.txt"
    params:
        threshold = config["mash"]["subspecies_threshold"]
    script:
        "scripts/assign_subspecies.py"

# ============================================================
# PHASE 2 — SNP CALLING (SNIPPY)
# ============================================================

rule snippy_abscessus:
    input:
        fasta = config["input_dir"] + "/{sample}.fasta",
        ref   = config["subspecies_refs"]["abscessus"]["path"],
        list  = "{out}/mash/subspecies/abscessus_samples.txt"
    output:
        vcf = "{out}/snippy/abscessus/{sample}/snps.vcf",
        txt = "{out}/snippy/abscessus/{sample}/snps.txt"
    conda: "envs/snippy.yaml"
    threads: config["snippy"]["cpus"]
    shell:
        """
        if grep -q {wildcards.sample} {input.list}; then
            snippy --ref {input.ref} \
                   --ctgs {input.fasta} \
                   --outdir {wildcards.out}/snippy/abscessus/{wildcards.sample} \
                   --cpus {threads} \
                   --force
        else
            mkdir -p {wildcards.out}/snippy/abscessus/{wildcards.sample}
            touch {output.vcf} {output.txt}
        fi
        """

rule snippy_massiliense:
    input:
        fasta = config["input_dir"] + "/{sample}.fasta",
        ref   = config["subspecies_refs"]["massiliense"]["path"],
        list  = "{out}/mash/subspecies/massiliense_samples.txt"
    output:
        vcf = "{out}/snippy/massiliense/{sample}/snps.vcf",
        txt = "{out}/snippy/massiliense/{sample}/snps.txt"
    conda: "envs/snippy.yaml"
    threads: config["snippy"]["cpus"]
    shell:
        """
        if grep -q {wildcards.sample} {input.list}; then
            snippy --ref {input.ref} \
                   --ctgs {input.fasta} \
                   --outdir {wildcards.out}/snippy/massiliense/{wildcards.sample} \
                   --cpus {threads} \
                   --force
        else
            mkdir -p {wildcards.out}/snippy/massiliense/{wildcards.sample}
            touch {output.vcf} {output.txt}
        fi
        """

rule snippy_core_abscessus:
    input:
        vcfs      = expand("{out}/snippy/abscessus/{sample}/snps.vcf",
                          out=OUT, sample=SAMPLES),
        ref       = config["subspecies_refs"]["abscessus"]["path"],
        abslist   = "{out}/mash/subspecies/abscessus_samples.txt",
        dcc_done  = "{out}/references/.dcc_refs_done"
    output:
        aln = "{out}/core/abscessus/core.aln"
    params:
        dcc_refs = "{out}/dcc_refs/abscessus"
    conda: "envs/snippy.yaml"
    shell:
        """
        # Run snippy on DCC reference reads
        for acc in SRR36966619 ERR363247 ERR1081288 ERR494841 ERR363431 ERR484982; do
            if [ -f {params.dcc_refs}/${{acc}}_1.fastq.gz ] && \
               [ ! -d {wildcards.out}/snippy/abscessus/${{acc}} ]; then
                snippy --ref {input.ref} \
                       --R1 {params.dcc_refs}/${{acc}}_1.fastq.gz \
                       --R2 {params.dcc_refs}/${{acc}}_2.fastq.gz \
                       --outdir {wildcards.out}/snippy/abscessus/${{acc}} \
                       --cpus 4 --force
            fi
        done

        # Build core alignment with patient isolates + DCC refs
        dirs=$(while read s; do echo {wildcards.out}/snippy/abscessus/$s; done < {input.abslist} | tr '\n' ' ')
        dcc_dirs=$(ls -d {wildcards.out}/snippy/abscessus/{{SRR36966619,ERR363247,ERR1081288,ERR494841,ERR363431,ERR484982}} 2>/dev/null | tr '\n' ' ')
        snippy-core --ref {input.ref} --prefix {wildcards.out}/core/abscessus/core $dirs $dcc_dirs || true
        # If no SNPs found use full alignment as fallback
        if [ ! -f {wildcards.out}/core/abscessus/core.aln ] || [ ! -s {wildcards.out}/core/abscessus/core.aln ]; then
            echo "No core SNPs — using full alignment as fallback"
            cp {wildcards.out}/core/abscessus/core.full.aln {wildcards.out}/core/abscessus/core.aln
        fi
        """

rule snippy_core_massiliense:
    input:
        vcfs     = expand("{out}/snippy/massiliense/{sample}/snps.vcf",
                         out=OUT, sample=SAMPLES),
        ref      = config["subspecies_refs"]["massiliense"]["path"],
        maslist  = "{out}/mash/subspecies/massiliense_samples.txt",
        dcc_done = "{out}/references/.dcc_refs_done"
    output:
        aln = "{out}/core/massiliense/core.aln"
    params:
        dcc_refs = "{out}/dcc_refs/massiliense"
    conda: "envs/snippy.yaml"
    shell:
        """
        # Map massiliense DCC reference reads
        for acc in ERR1045629 ERR2524314 ERR363320; do
            if [ -f {params.dcc_refs}/${{acc}}_1.fastq.gz ] && \
               [ ! -d {wildcards.out}/snippy/massiliense/${{acc}} ]; then
                snippy --ref {input.ref} \
                       --R1 {params.dcc_refs}/${{acc}}_1.fastq.gz \
                       --R2 {params.dcc_refs}/${{acc}}_2.fastq.gz \
                       --outdir {wildcards.out}/snippy/massiliense/${{acc}} \
                       --cpus 4 --force
            fi
        done

        # Map massiliense assembly refs (A47, FLAC047)
        for name in A47 FLAC047; do
            if [ -f {params.dcc_refs}/${{name}}.fna ] && \
               [ ! -d {wildcards.out}/snippy/massiliense/${{name}} ]; then
                snippy --ref {input.ref} \
                       --ctgs {params.dcc_refs}/${{name}}.fna \
                       --outdir {wildcards.out}/snippy/massiliense/${{name}} \
                       --cpus 4 --force
            fi
        done

        # Build core alignment
        dirs=$(while read s; do echo {wildcards.out}/snippy/massiliense/$s; done < {input.maslist} | tr '\n' ' ')
        dcc_dirs=$(ls -d {wildcards.out}/snippy/massiliense/{{ERR1045629,ERR2524314,ERR363320,A47,FLAC047}} 2>/dev/null | tr '\n' ' ')

        if [ -z "$dirs" ] && [ -z "$dcc_dirs" ]; then
            echo "No massiliense samples — creating empty alignment"
            touch {output.aln}
        else
            snippy-core --ref {input.ref} \
                --prefix {wildcards.out}/core/massiliense/core $dirs $dcc_dirs || true
            if [ ! -s {output.aln} ]; then
                cp {wildcards.out}/core/massiliense/core.full.aln {output.aln}
            fi
        fi
        """

# ============================================================
# PHASE 3 — POPULATION STRUCTURE (FASTBAPS)
# ============================================================

rule fastbaps_abscessus:
    input:
        aln = "{out}/core/abscessus/core.aln"
    output:
        clusters = "{out}/fastbaps/abscessus/clusters.csv"
    conda: "envs/fastbaps.yaml"
    threads: config["fastbaps"]["threads"]
    shell:
        """
        run_fastbaps \
            -i {input.aln} \
            -o {output.clusters} \
            -p {config[fastbaps][prior]} \
            -l {config[fastbaps][levels]} \
            -t {threads}
        """

rule fastbaps_massiliense:
    input:
        aln = "{out}/core/massiliense/core.aln"
    output:
        clusters = "{out}/fastbaps/massiliense/clusters.csv"
    conda: "envs/fastbaps.yaml"
    threads: config["fastbaps"]["threads"]
    shell:
        """
        if [ -s {input.aln} ]; then
            run_fastbaps \
                -i {input.aln} \
                -o {output.clusters} \
                -p {config[fastbaps][prior]} \
                -l {config[fastbaps][levels]} \
                -t {threads}
        else
            echo "No massiliense sequences — skipping FastBAPS"
            touch {output.clusters}
        fi
        """

